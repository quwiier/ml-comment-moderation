<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TOBE" targetNamespace="https://example.edu/moderation">
  <bpmn:message id="Msg_New" name="Новый комментарий"/><bpmn:message id="Msg_Appeal2" name="Апелляция"/><bpmn:error id="Err_Model" name="Model timeout/error" errorCode="MODEL_UNAVAILABLE"/>
  <bpmn:collaboration id="Collaboration_TOBE"><bpmn:participant id="P_User" name="Пользователь"/><bpmn:participant id="P_System" name="ML-платформа модерации" processRef="Process_TOBE"/><bpmn:messageFlow id="MF_New" sourceRef="P_User" targetRef="Start_New"/><bpmn:messageFlow id="MF_Appeal" sourceRef="P_User" targetRef="Catch_Appeal2"/></bpmn:collaboration>
  <bpmn:process id="Process_TOBE" name="TO-BE модерация" isExecutable="false">
    <bpmn:laneSet id="LS_TOBE"><bpmn:lane id="Lane_Social" name="Социальная сеть"><bpmn:flowNodeRef>Start_New</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Publish</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Emit</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Allow</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Hide</bpmn:flowNodeRef><bpmn:flowNodeRef>T_ApplyFinal</bpmn:flowNodeRef><bpmn:flowNodeRef>Catch_Appeal2</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Restore2</bpmn:flowNodeRef><bpmn:flowNodeRef>End_TOBE</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_ML" name="ML-контур"><bpmn:flowNodeRef>T_Pre</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Infer</bpmn:flowNodeRef><bpmn:flowNodeRef>B_Model</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Fallback</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Policy</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Route</bpmn:flowNodeRef><bpmn:flowNodeRef>T_CreateNormal</bpmn:flowNodeRef><bpmn:flowNodeRef>T_CreatePriority</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Human" name="Модератор"><bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>T_AppealReview</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Overturn2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Data" name="Данные и ML Ops"><bpmn:flowNodeRef>G_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>G_After</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Audit</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Feedback</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Join</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Dataset</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Train</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Register</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_New" name="Новый комментарий"><bpmn:messageEventDefinition messageRef="Msg_New"/></bpmn:startEvent><bpmn:serviceTask id="T_Publish" name="Сохранить и опубликовать"/><bpmn:serviceTask id="T_Emit" name="Записать событие в bus"/><bpmn:serviceTask id="T_Pre" name="Предобработать"/><bpmn:serviceTask id="T_Infer" name="Получить prediction"/><bpmn:boundaryEvent id="B_Model" name="Timeout / error" attachedToRef="T_Infer"><bpmn:errorEventDefinition errorRef="Err_Model"/></bpmn:boundaryEvent><bpmn:serviceTask id="T_Fallback" name="Fallback: критические правила"/><bpmn:businessRuleTask id="T_Policy" name="Применить policy и пороги"/><bpmn:exclusiveGateway id="G_Route" name="Маршрут риска"/>
    <bpmn:serviceTask id="T_Allow" name="ALLOW: оставить видимым"/><bpmn:serviceTask id="T_CreateNormal" name="REVIEW: обычная задача"/><bpmn:serviceTask id="T_Hide" name="TEMP_HIDE: временно скрыть"/><bpmn:serviceTask id="T_CreatePriority" name="Создать приоритетную задачу"/><bpmn:userTask id="T_Review" name="Проверить и принять решение"/><bpmn:serviceTask id="T_ApplyFinal" name="Применить финальное решение"/>
    <bpmn:exclusiveGateway id="G_Merge" name="Слить альтернативные маршруты"/><bpmn:parallelGateway id="G_After" name="Аудит и feedback"/><bpmn:serviceTask id="T_Audit" name="Записать AuditEvent"/><bpmn:serviceTask id="T_Feedback" name="Записать FeedbackEvent"/><bpmn:parallelGateway id="G_Join"/><bpmn:serviceTask id="T_Dataset" name="Сформировать DatasetVersion"/><bpmn:serviceTask id="T_Train" name="Обучить и проверить кандидата"/><bpmn:serviceTask id="T_Register" name="Зарегистрировать после approval"/><bpmn:endEvent id="End_TOBE" name="Обработка завершена"/>
    <bpmn:startEvent id="Catch_Appeal2" name="Апелляция"><bpmn:messageEventDefinition messageRef="Msg_Appeal2"/></bpmn:startEvent><bpmn:userTask id="T_AppealReview" name="Приоритетно проверить апелляцию"/><bpmn:exclusiveGateway id="G_Overturn2" name="Отменить решение?"/><bpmn:serviceTask id="T_Restore2" name="Восстановить контент"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_New" targetRef="T_Publish"/><bpmn:sequenceFlow id="F2" sourceRef="T_Publish" targetRef="T_Emit"/><bpmn:sequenceFlow id="F3" sourceRef="T_Emit" targetRef="T_Pre"/><bpmn:sequenceFlow id="F4" sourceRef="T_Pre" targetRef="T_Infer"/><bpmn:sequenceFlow id="F5" sourceRef="T_Infer" targetRef="T_Policy"/><bpmn:sequenceFlow id="FErr" sourceRef="B_Model" targetRef="T_Fallback"/><bpmn:sequenceFlow id="FFallback" sourceRef="T_Fallback" targetRef="T_Policy"/><bpmn:sequenceFlow id="F6" sourceRef="T_Policy" targetRef="G_Route"/>
    <bpmn:sequenceFlow id="FAllow" name="низкий риск &lt; 0,40" sourceRef="G_Route" targetRef="T_Allow"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">route == 'ALLOW'</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="FReview" name="0,40–0,85 или низкая уверенность" sourceRef="G_Route" targetRef="T_CreateNormal"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">route == 'REVIEW'</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="FHide" name="опасный риск ≥ 0,85" sourceRef="G_Route" targetRef="T_Hide"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">route == 'TEMP_HIDE'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="T_CreateNormal" targetRef="T_Review"/><bpmn:sequenceFlow id="F8" sourceRef="T_Hide" targetRef="T_CreatePriority"/><bpmn:sequenceFlow id="F9" sourceRef="T_CreatePriority" targetRef="T_Review"/><bpmn:sequenceFlow id="F10" sourceRef="T_Review" targetRef="T_ApplyFinal"/><bpmn:sequenceFlow id="F11" sourceRef="T_ApplyFinal" targetRef="G_Merge"/><bpmn:sequenceFlow id="FAllowAfter" sourceRef="T_Allow" targetRef="G_Merge"/><bpmn:sequenceFlow id="FMergeSplit" sourceRef="G_Merge" targetRef="G_After"/><bpmn:sequenceFlow id="FAudit" sourceRef="G_After" targetRef="T_Audit"/><bpmn:sequenceFlow id="FFeedback" sourceRef="G_After" targetRef="T_Feedback"/><bpmn:sequenceFlow id="FAuditJoin" sourceRef="T_Audit" targetRef="G_Join"/><bpmn:sequenceFlow id="FFeedbackJoin" sourceRef="T_Feedback" targetRef="G_Join"/><bpmn:sequenceFlow id="FEnd" sourceRef="G_Join" targetRef="End_TOBE"/><bpmn:sequenceFlow id="FData" sourceRef="T_Feedback" targetRef="T_Dataset"/><bpmn:sequenceFlow id="FTrain" sourceRef="T_Dataset" targetRef="T_Train"/><bpmn:sequenceFlow id="FRegister" sourceRef="T_Train" targetRef="T_Register"/>
    <bpmn:sequenceFlow id="FA1" sourceRef="Catch_Appeal2" targetRef="T_AppealReview"/><bpmn:sequenceFlow id="FA2" sourceRef="T_AppealReview" targetRef="G_Overturn2"/><bpmn:sequenceFlow id="FAOver" name="да" sourceRef="G_Overturn2" targetRef="T_Restore2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">overturn</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="FAKeep" name="нет" sourceRef="G_Overturn2" targetRef="G_Merge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not overturn</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="FARestore" sourceRef="T_Restore2" targetRef="G_Merge"/>
    <bpmn:dataObject id="D_CommentEvent" name="CommentEvent"/><bpmn:dataObjectReference id="DR_CommentEvent" dataObjectRef="D_CommentEvent"/><bpmn:dataObject id="D_Prediction" name="Prediction"/><bpmn:dataObjectReference id="DR_Prediction" dataObjectRef="D_Prediction"/><bpmn:dataObject id="D_Policy" name="PolicyVersion"/><bpmn:dataObjectReference id="DR_Policy" dataObjectRef="D_Policy"/><bpmn:dataObject id="D_Decision" name="ModerationDecision"/><bpmn:dataObjectReference id="DR_Decision" dataObjectRef="D_Decision"/><bpmn:dataObject id="D_Feedback" name="FeedbackEvent"/><bpmn:dataObjectReference id="DR_Feedback" dataObjectRef="D_Feedback"/><bpmn:dataObject id="D_Dataset" name="DatasetVersion"/><bpmn:dataObjectReference id="DR_Dataset" dataObjectRef="D_Dataset"/><bpmn:dataObject id="D_Model" name="ModelVersion"/><bpmn:dataObjectReference id="DR_Model" dataObjectRef="D_Model"/><bpmn:dataObject id="D_Audit" name="AuditEvent"/><bpmn:dataObjectReference id="DR_Audit" dataObjectRef="D_Audit"/>
  </bpmn:process>
